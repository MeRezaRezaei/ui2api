[Unit]
Description=ui2api API (promptd) — OpenAI-compatible + capability endpoints
Documentation=https://github.com/MeRezaRezaei/ui2api
After=network-online.target ui2api-xvfb.service ui2api-chrome.service
Wants=network-online.target ui2api-xvfb.service
# Chrome is wanted, not required: promptd must still come up and answer
# honestly ("no browser") rather than not come up at all.
After=ui2api-chrome.service

[Service]
Type=simple
# WHO RUNS THE API — and why this comment previously argued the OPPOSITE.
#
# This block used to argue at length for `User=me`, on the grounds that the vault
# belonged to the operator and `ui2api` could not read it. Both halves were true
# at the time and BOTH are now false: the vault is owned by `ui2api`, and the line
# below is `User=ui2api`. The stale reasoning was left sitting directly above the
# value it contradicted, which is the worst place a wrong comment can be — it is
# trusted, and it would have walked the next reader straight back into the
# incident it described.
#
# WHAT THE STALE REASONING GOT WRONG, because it is the reusable part. It asked
# "who owns the credentials?" and answered "therefore the daemon must run as that
# user", then never checked the other side of the same boundary. MEASURED: with
# `User=me` the daemon drove a browser it did not own, `realProfileInPlay` was
# `false`, and every chat site replayed signed-out — 23 minutes of `GET /health`
# returning `ok: true` while serving 22 models it could not drive. The daemon
# needed the same identity as the BROWSER, not as the credential file.
#
# So: Chrome, the vault, and the API all run as `ui2api`. One user owns the
# profile, the sessions, and the process that reads them, and there is no
# cross-user seam for a session to get lost in. The operator keeps full access
# through sudo, which is the right shape for a human doing maintenance on a
# service account's files.
#
# The 0600/0700 hardening is unchanged and still pinned — ownership moved, the
# modes did not.
User=ui2api
Group=ui2api
WorkingDirectory=/opt/ui2api
Environment=HOME=/home/ui2api
# The DEPLOYED tree, not a git checkout. Written only by scripts/ops/deploy.sh.
# THE VAULT. The captured sessions live in the operator's checkout and are real
# login state; a deploy must never move or overwrite them, so the service is
# pointed at them explicitly instead of inheriting a default relative to its own
# install dir. Get this wrong and the service starts perfectly and replays
# signed-out on every site — a silent total failure, not an error.
Environment=UI2API_DATA_DIR=/home/me/Documents/projects/ui2api/data
Environment=UI2API_CHROME_USER=ui2api
Environment=UI2API_PROMPTD_PORT=9797
Environment=UI2API_ATTACH_PORT=9222
Environment=UI2API_DAEMON_PORT=9222
# A display is what makes this TRUE. Without Xvfb the daemon silently falls back
# to --headless=new and the sites challenge it.
Environment=UI2API_HEADED=1
Environment=DISPLAY=:99
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/ui2api/dist/cli.js promptd
Restart=always
RestartSec=5
TimeoutStopSec=30
PrivateTmp=false
# The API is the project's documented surface and binds 127.0.0.1 only.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/ui2api

[Install]
WantedBy=multi-user.target
