{
  "name": "ui2api",
  "version": "0.1.0",
  "description": "Turn any website into MCP/ACP tools for AI — analyze a site's real action recipes and generate a per-site MCP server.",
  "type": "module",
  "bin": {
    "ui2api": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "acp",
    "ai-agents",
    "browser",
    "playwright",
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YOURGITHUB/ui2api"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "analyse": "tsx src/cli.ts analyse",
    "generate": "tsx src/cli.ts generate",
    "serve": "tsx src/cli.ts serve",
    "remap": "tsx src/cli.ts remap",
    "test": "tsx test/integration.ts",
    "test:unit": "node --import tsx --test test/agent.test.ts test/session.test.ts test/acp.test.ts test/security.test.ts",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.40.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
